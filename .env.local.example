# Groq API key — powers the AI interviewer, the report, and voice input.
# Get one at https://console.groq.com/keys
# NOTE: the free tier allows 8,000 tokens/minute. A full 12-question interview
# plus its report needs roughly 20k, so a paid tier is worth it before a live
# demo. Check your headroom at /api/health (the `groq:quota` row).
GROQ_API_KEY=

# Chat model. Optional — defaults to openai/gpt-oss-120b.
# Groq retires models without notice; verify an id is live with:
#   curl -H "Authorization: Bearer $GROQ_API_KEY" https://api.groq.com/openai/v1/models
GROQ_MODEL=

# MongoDB Atlas connection string — stores interview sessions + reports.
# Recommended, but not required: without it (or if Atlas is unreachable, e.g.
# an IP allowlist blocking the venue Wi-Fi) interviews and reports run from
# memory for the life of the server process.
# Get one at https://www.mongodb.com/cloud/atlas
MONGODB_URI=

# Cartesia API key — the interviewer's voice in voice mode.
# Optional; text mode works without it, and voice mode falls back to the
# browser's built-in speech synthesis.
# Get one at https://cartesia.ai (Dashboard → API Keys → key starts with sk_car_)
CARTESIA_API_KEY=

# Set to true only after adding MP3s to /public/sounds (see the README there).
# Left unset, click sounds are synthesized in the browser and no files are
# requested.
NEXT_PUBLIC_SOUND_SAMPLES=

# Tavus — real-time photorealistic VIDEO interviewer (video mode).
# Optional; text mode works without it. Free dev account = 25 minutes.
# Sign up: https://platform.tavus.io  →  Dashboard → API Keys
# Pick a stock replica face: https://platform.tavus.io/replicas
TAVUS_API_KEY=
TAVUS_REPLICA_ID=

# Public URL Tavus must reach to call HireLoop's Groq interview brain.
# LOCAL DEV: run `ngrok http 3000` and paste the https URL here.
# PRODUCTION: set to your deployment URL (e.g. https://hireloop.vercel.app).
NEXT_PUBLIC_APP_URL=
